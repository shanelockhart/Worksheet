# Copy these into Netlify (Site configuration > Environment variables), or into a local .env for `netlify dev`.
# NEVER commit real values. Mark every key/secret below as "Contains secret values" in Netlify.

# --- AI provider (required) ---
AI_API_KEY=                      # secret. Provider API key.
AI_PROVIDER=anthropic            # anthropic | openai  (openai = any OpenAI-compatible chat completions API)
AI_MODEL=claude-haiku-5-5        # model id for the provider above
AI_BASE_URL=                     # optional. Default: https://api.anthropic.com or https://api.openai.com/v1
AI_MAX_OUTPUT_TOKENS=700         # hard cap on reply length
AI_TIMEOUT_MS=25000              # provider timeout; keep well under the 60s function limit
AI_EFFORT=                       # optional (anthropic only): low | medium | high. Leave empty unless you know the model supports it.

# --- Persistent rate limiting (required) ---
SUPABASE_URL=                    # https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=       # secret. Server only. Run supabase/schema.sql first.
SESSION_SECRET=                  # secret. 32+ random characters. Signs guest sessions and hashes IPs.

# --- Limits (all optional; defaults shown) ---
LIMIT_PER_WINDOW=5               # questions per user per window
LIMIT_WINDOW_MINUTES=60          # rolling window length
IP_LIMIT_PER_WINDOW=20           # questions per network (IP) per window, across all sessions
NEW_SESSIONS_PER_IP=10           # new guest sessions one network may create per window
DAILY_CAP=500                    # global questions per UTC day across everyone. 0 = no cap (not recommended)
MAX_INPUT_CHARS=600              # max length of one question
MAX_HISTORY_MESSAGES=6           # prior messages sent to the model for context
MAX_HISTORY_CHARS=3000           # total characters of prior messages sent

# --- Optional ---
ALLOWED_ORIGINS=                 # comma-separated extra origins allowed to call /api (same origin is always allowed)
AUTH_ENABLED=false               # true = accept a Supabase user access token (Authorization: Bearer) as a per-user identity
KNOWLEDGE_INCLUDE_ARCHIVE=true   # include the unverified git-history archive (clearly labeled) in the model's knowledge
